5 \u0437\u0430\u043a\u0430\u0437\u043e\u0432 \u0438 \u0438\u043d\u0442\u0435\u0433\u0440\u0430\u0446\u0438\u044f \u0441 \u043b\u043e\u0433\u0438\u0441\u0442\u0438\u043a\u043e\u0439 \u2014 \u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0438\u0439 \u044d\u0442\u0430\u043f, \u043d\u0430\u0447\u0430\u043b\u043e 2027 \u0433\u043e\u0434\u0430. \u0424\u0438\u043d\u0430\u043b\u044c\u043d\u044b\u0439 \u0441\u0442\u0430\u0442\u0443\u0441 \u044d\u0442\u0438\u043c \u0440\u0435\u0448\u0435\u043d\u0438\u0435\u043c \u043d\u0435 \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0451\u043d. \u0415\u0433\u043e \u043e\u0431\u0441\u0443\u0436\u0434\u0430\u044e\u0442 \u0441 1C Solution Architect (\u0410\u0440\u0442\u0435\u043c \u041a\u043e\u043b\u043e\u0441\u043e\u0432). \u0412\u0430\u0440\u0438\u0430\u043d\u0442\u044b: 1. \u0420\u0443\u0447\u043d\u0430\u044f \u043a\u043d\u043e\u043f\u043a\u0430 \u00ab\u0414\u0435\u043d\u044c\u0433\u0438 \u0432\u043e\u0437\u0432\u0440\u0430\u0449\u0435\u043d\u044b\u00bb \u0434\u043b\u044f \u0441\u043e\u0442\u0440\u0443\u0434\u043d\u0438\u043a\u0430, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0432\u043e\u0437\u0432\u0440\u0430\u0449\u0430\u0435\u0442 \u0434\u0435\u043d\u044c\u0433\u0438; \u0444\u0438\u043d\u0430\u043b\u044c\u043d\u044b\u0439 \u0441\u0442\u0430\u0442\u0443\u0441 \u2014 \u00ab\u0412\u043e\u0437\u0432\u0440\u0430\u0442 \u0432\u044b\u043f\u043e\u043b\u043d\u0435\u043d, \u0434\u0435\u043d\u044c\u0433\u0438 \u0432\u043e\u0437\u0432\u0440\u0430\u0449\u0435\u043d\u044b\u00bb. 2. \u0411\u0435\u0437 \u0442\u0430\u043a\u043e\u0439 \u043a\u043d\u043e\u043f\u043a\u0438 \u2014 \u0444\u0438\u043d\u0430\u043b\u044c\u043d\u044b\u0439 \u0441\u0442\u0430\u0442\u0443\u0441 \u043f\u043e \u043f\u0440\u0438\u0451\u043c\u043a\u0435: \u0438\u0437\u0434\u0435\u043b\u0438\u0435 \u0434\u043e\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u043e \u043d\u0430 \u0441\u043a\u043b\u0430\u0434 \u0438\u043b\u0438 \u043f\u0440\u0438\u043d\u044f\u0442\u043e \u0432 \u043c\u0430\u0433\u04