442\u0442\u0430\u00bb \u0435\u0433\u043e \u043f\u0440\u0438\u043d\u0438\u043c\u0430\u0435\u0442; - \u0435\u0441\u043b\u0438 \u0438\u0434\u0435\u043d\u0442\u0438\u0444\u0438\u043a\u0430\u0442\u043e\u0440\u0430 \u043d\u0435\u0442, \u043f\u043e\u0441\u044b\u043b\u043a\u0430 \u0443\u0445\u043e\u0434\u0438\u0442 \u0432 \u0430\u043d\u043e\u043c\u0430\u043b\u0438\u0438 (\u043a\u0430\u0440\u0430\u043d\u0442\u0438\u043d) \u0438 \u0434\u0430\u043b\u044c\u0448\u0435 \u0432 \u0442\u043e\u0432\u0430\u0440\u043e\u0434\u0432\u0438\u0436\u0435\u043d\u0438\u0435. \u041e\u0442\u043a\u0440\u044b\u0442 \u0432\u043e\u043f\u0440\u043e\u0441, \u0447\u0442\u043e \u0434\u0435\u043b\u0430\u0442\u044c \u0441 \u043f\u0440\u0438\u043d\u044f\u0442\u043e\u0439 \u043f\u043e\u0441\u044b\u043b\u043a\u043e\u0439 \u0431\u0435\u0437 \u0437\u0430\u044f\u0432\u043a\u0438: - \u043e\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u044c \u043f\u0440\u043e\u0446\u0435\u0441\u0441 \u0438 \u0436\u0434\u0430\u0442\u044c \u0437\u0430\u044f\u0432\u043a\u0443 \u043e\u0442 \u043a\u043b\u0438\u0435\u043d\u0442\u0430 \u0438\u043b\u0438 \u0414\u0440\u0443\u0436\u0431\u044b; - \u0441\u043e\u0437\u0434\u0430\u0442\u044c \u0437\u0430\u044f\u0432\u043a\u0443 \u0437\u0430 \u043a\u043b\u0438\u0435\u043d\u0442\u0430."}], "edges": [{"source": "projects_returns_2_0_requirements_adr__2026_10_01_14_59__adr_ret_037_warehouse_return_without_application_v2", "target": "projects_returns_2_0_requirements_adr__2026_09_17_15_01__adr_ret_022_warehouse_return_without_application_v1", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "projects/returns-2.0/requirements/adr/[2026-10-01 14-59] ADR-RET-037-warehouse-return-without-application-v2.md", "source_location": null, "weight": 1.0}, {"source": "projects_returns_2_0_requirements_adr__2026_10_01_14_59__adr_ret_037_warehouse_return_without_application_v2", "target": "projects_returns_2_0_requirements_brd_br_05", "relation": "rationale_for", "con