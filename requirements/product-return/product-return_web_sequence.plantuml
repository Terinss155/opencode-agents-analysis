@startuml
autonumber "<b><color:DarkSlateBlue>.</color></b> "

title "Процесс возврата товара: создание заявки на веб-сайте (ЛК)"

' ============================================================
' УЧАСТНИКИ
' ============================================================
actor Client as "Клиент (ЛК, веб)"
participant "Web Frontend" as FE
participant "RefundController\n(Web REST)" as RefundCtrl
participant "Order" as Order
participant "OrderPosition" as Pos
participant "ReturnReason /\nReturnReasonGroup" as Reason
participant "UserRefund" as UR
participant "OrderRefundService" as RefundSvc
participant "OrderService" as OrderSvc
participant "Outbox\n(Lamoda/RCRM/Mindbox)" as Outbox

' ============================================================
' ЭТАП 1. ПРОВЕРКА ВОЗМОЖНОСТИ ВОЗВРАТА
' ============================================================
== 1. Проверка возможности возврата ==
Client -> FE : Открывает карточку заказа
FE -> RefundCtrl : HTTP GET /refund/get-positions-json?id={orderId}
RefundCtrl -> Order : findOneByIdAndUserId(orderId, userId)
Order --> RefundCtrl : Заказ (или null)
alt Заказ не найден
    RefundCtrl --> FE : JSON {success:false, "Заказ не найден"}
else Заказ найден
    RefundCtrl -> Pos : findAllForRefundByOrderId(orderId)\n(status=STATUS_ADDED, price>PRESENT_MAX)
    Pos --> RefundCtrl : Позиции, доступные к возврату
    RefundCtrl -> Reason : findActiveGroupsWithReasons()
    Reason --> RefundCtrl : Активные группы причин
    RefundCtrl -> Order : getPaymentTypeId()\n(online или нет)
    RefundCtrl --> FE : JSON {positions, reason_groups, need_bank_details}
end

' ============================================================
' ЭТАП 2. БАНКОВСКИЕ РЕКВИЗИТЫ (только не-онлайн оплата)
' ============================================================
== 2. Банковские реквизиты (не-онлайн оплата) ==
opt need_bank_details == true
    FE -> RefundCtrl : HTTP GET /refund/get-bank-data-json
    RefundCtrl -> UR : findOneByUserId(userId)
    UR --> RefundCtrl : Сохранённые реквизиты (или пустая модель)
    RefundCtrl --> FE : JSON {банковские реквизиты}

    FE -> RefundCtrl : HTTP POST /refund/save-bank-data-json
    RefundCtrl -> RefundCtrl : RefundBankDataForm::validate()
    alt Валидация успешна
        RefundCtrl -> UR : findOneByUserId / createModel
        RefundCtrl -> RefundCtrl : UserRefundService::fillModelByForm()
        RefundCtrl -> UR : save()
        UR --> RefundCtrl : ok
        RefundCtrl --> FE : JSON {success:true}
    else Ошибка валидации
        RefundCtrl --> FE : JSON {success:false, errors}
    end
end

' ============================================================
' ЭТАП 3. СОЗДАНИЕ ЗАЯВКИ НА ВОЗВРАТ
' ============================================================
== 3. Создание заявки на возврат ==
Client -> FE : Выбирает позиции и причины, подтверждает
FE -> RefundCtrl : HTTP POST /refund/save-reason-json
RefundCtrl -> RefundCtrl : SaveReasonForm::validate()\n(позиции + reasonCode)
alt Валидация не пройдена
    RefundCtrl --> FE : JSON {success:false, errors}
else Валидация пройдена
    RefundCtrl -> RefundSvc : refundPositions(form, user)
    RefundSvc -> RefundSvc : getOrderPositions(form)
    RefundSvc -> UR : findOneByUserId(userId)
    RefundSvc -> RefundSvc : validateReasons()\n(принадлежность заказа, reason_code,\nuser_refund для не-онлайн)
    RefundSvc -> RefundSvc : beginTransaction()
    loop по каждой позиции
        RefundSvc -> Order : setUserRefund() (если не-онлайн)
        RefundSvc -> Order : unsafeSave()
        RefundSvc -> Pos : returnPosition(reasonCode)
        Pos -> Pos : status = STATUS_LOST, reason = reasonCode
        Pos -> Order : updateReturnStatus()\n(если есть возвращённые -> STATUS_ORDER_RETURNED_LK)
        RefundSvc -> Outbox : LamodaOrderOutboxService::changeStatus(order)
        RefundSvc -> OrderSvc : changeStatus(order)
    end
    RefundSvc -> Outbox : RcrmOutboxService::pushUpdateOrder(order)
    RefundSvc -> Outbox : MindboxOutboxService::pushUpdateOrder(order)
    RefundSvc -> RefundSvc : commit()
    RefundSvc --> RefundCtrl : ok
    RefundCtrl --> FE : JSON {success:true}
end

@enduml