{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "system-analyst",
  "model": "opencode/big-pickle",
  "skills": {
    "paths": ["./skill"]
  },
  "permission": {
    "edit": "ask",
    "bash": "ask",
    "skill": {
      "*": "deny",
      "backend-logic": "allow",
      "erd-model": "allow",
      "sequence-diagram": "allow",
      "openapi-spec": "allow",
      "asyncapi-spec": "allow",
      "nfr-requirements": "allow",
      "user-story": "allow",
      "use-case": "allow",
      "brs": "allow",
      "screen-spec": "allow",
      "backlog-prioritization": "allow",
      "business-case": "allow",
      "product-roadmap": "allow",
      "stakeholder-map": "allow",
      "business-process-bpmn": "allow",
      "brd": "allow",
      "traceability-matrix": "allow",
      "adr": "allow",
      "security-review-checklist": "allow"
    }
  }
}
